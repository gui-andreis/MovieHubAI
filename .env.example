# Copie para .env e preencha. NUNCA comite o .env.

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# MovieHub API (.NET). Local: http://localhost:5000 | Docker: http://host.docker.internal:5000
MOVIEHUB_API_URL=http://localhost:5000

# Redis opcional (vazio = memória local). Upstash: rediss://default:<senha>@<host>:6379
REDIS_URL=

# Origens permitidas no CORS (CSV)
ALLOWED_ORIGINS=http://localhost:3000

ENVIRONMENT=development
PORT=8000

# Ajustes finos (opcionais)
# MAX_TOOL_ITERATIONS=6
# HISTORY_MAX_MESSAGES=20
# RATE_LIMIT_PER_MINUTE=20
